# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# secrets — never commit; .env.example is the only template allowed
.env*
!.env.example
*.pem
*.key
*.p12
.vercel
.netrc
.npmrc

# local data and scratch (JSON KV store, agent ledgers, workflow state)
.data/
.superpowers/
.workflow-data*/
.claude/settings.local.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js / build output
/.next/
/out/
/build
/.swc
next-env.d.ts

# testing
/coverage
playwright-report/
test-results/
.playwright/

# typescript
*.tsbuildinfo
tsconfig.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# misc
.DS_Store
